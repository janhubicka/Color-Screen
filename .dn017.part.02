   }
 
 
+  /* Multiplicative scan noise is additive in density space.  Use a linear
+     density ramp so the deterministic signal cancels there while its
+     exponential transmission has curvature in linear intensity.  The domain
+     comparison should therefore make the density scale ratios substantially
+     closer to one and improve the spacing-1 variance fit.  */
+  {
+    const int w = 96, h = 72;
+    const luminosity_t density_sigma = (luminosity_t)0.025;
+    std::vector<luminosity_t> data ((size_t)w * h), support ((size_t)w * h, 1);
+    unsigned int noise_seed = 0x76543210U;
+    auto gaussian = [&] () -> luminosity_t
+    {
+      luminosity_t u1
+          = ((luminosity_t)fast_rand16 (&noise_seed) + 1) / (luminosity_t)32768;
+      luminosity_t u2
+          = ((luminosity_t)fast_rand16 (&noise_seed) + 1) / (luminosity_t)32768;
+      return std::sqrt ((luminosity_t)-2 * std::log (u1))
+             * std::cos ((luminosity_t)6.2831853071795864769 * u2);
+    };
+    for (int y = 0; y < h; y++)
+      for (int x = 0; x < w; x++)
+        {
+          luminosity_t density
+              = (luminosity_t)0.15
+                + (luminosity_t)1.7 * x / (w - 1)
+                + (luminosity_t)0.08 * y / (h - 1);
+          data[(size_t)y * w + x]
+              = std::exp (-density + density_sigma * gaussian ());
+        }
+    auto identity_to_scr = [] (int_point_t p) -> point_t
+      { return {(coord_t)p.x, (coord_t)p.y}; };
+    denoise_noise_domain_comparison domains
+        = estimate_screen_noise_domain_comparison (
+            w, h, [&] (int x, int y) { return data[(size_t)y * w + x]; },
+            [&] (int x, int y) { return support[(size_t)y * w + x]; },
+            identity_to_scr);
+    denoise_noise_three_scale_estimate direct
+        = estimate_screen_noise_three_scale_model (
+            w, h, [&] (int x, int y) { return data[(size_t)y * w + x]; },
+            [&] (int x, int y) { return support[(size_t)y * w + x]; },
+            identity_to_scr);
+    if (!domains.linear.valid_p () || !domains.density.valid_p ()
+        || domains.linear.spacing2_variance_ratio
+               != direct.spacing2_variance_ratio
+        || domains.linear.spacing3_variance_ratio
+               != direct.spacing3_variance_ratio
+        || fabs (domains.density.spacing2_variance_ratio - (luminosity_t)1)
+               >= fabs (domains.linear.spacing2_variance_ratio
+                        - (luminosity_t)1)
+        || fabs (domains.density.spacing3_variance_ratio - (luminosity_t)1)
+               >= fabs (domains.linear.spacing3_variance_ratio
+                        - (luminosity_t)1)
+        || !(domains.density.spacing1.relative_fit_error
+             < domains.linear.spacing1.relative_fit_error))
+      {
+        fprintf (stderr,
+                 "Density-domain diagnostic mismatch: linear ratios %g %g "
+                 "error %g; density ratios %g %g error %g\n",
+                 (double)domains.linear.spacing2_variance_ratio,
+                 (double)domains.linear.spacing3_variance_ratio,
+                 (double)domains.linear.spacing1.relative_fit_error,
+                 (double)domains.density.spacing2_variance_ratio,
+                 (double)domains.density.spacing3_variance_ratio,
+                 (double)domains.density.spacing1.relative_fit_error);
+        return false;
+      }
+  }
+
+  /* The generalized square-root transform integrates 1/sqrt(A+B*x).  Check
+     its local variance stabilization directly, including the constant-noise
+     B=0 limit, before relying on it in the screen-sample diagnostic.  */
+  {
+    const luminosity_t a = (luminosity_t)0.0004;
+    const luminosity_t b = (luminosity_t)0.003;
+    for (luminosity_t x : {(luminosity_t)0.05, (luminosity_t)0.4,
+                           (luminosity_t)0.85})
+      {
+        const luminosity_t eps = (luminosity_t)1e-5;
+        luminosity_t lo, hi;
+        if (!denoise_noise_estimator_detail::variance_stabilizing_transform (
+                x - eps, a, b, &lo)
+            || !denoise_noise_estimator_detail::variance_stabilizing_transform (
