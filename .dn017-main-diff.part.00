diff --git a/src/libcolorscreen/lens-warp-correction.C b/src/libcolorscreen/lens-warp-correction.C
index 4e4dde0c0e24ed629ca29979d77e1d4172f0885e..a294bfdf92c8faa00b089484835037d40b05310a 100644
