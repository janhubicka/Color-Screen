+        return ret;
+      }
+
+    gsl_matrix *v = gsl_matrix_alloc (nvals, nvals);
+    gsl_vector *singular = gsl_vector_alloc (nvals);
+    gsl_vector *work = gsl_vector_alloc (nvals);
