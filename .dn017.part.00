   }
 };
 
+/* Compare the same three-scale screen-sample diagnostic in linear intensity,
+   density/log and a variance-stabilized domain.  The stabilized transform is
+   derived from the linear spacing-1 model variance = A + B * signal and is
+   diagnostic only; this structure never changes rendering parameters.  */
+struct denoise_noise_domain_comparison
+{
+  denoise_noise_three_scale_estimate linear;
+  denoise_noise_three_scale_estimate density;
+  denoise_noise_three_scale_estimate variance_stabilized;
+  luminosity_t vst_source_variance_floor = 0;
+  luminosity_t vst_source_variance_slope = 0;
+
+  bool valid_p () const
+  {
+    return linear.valid_p ();
+  }
+
+  bool vst_valid_p () const
+  {
+    return variance_stabilized.valid_p ()
+           && my_isfinite (vst_source_variance_floor)
+           && vst_source_variance_floor > 0
+           && my_isfinite (vst_source_variance_slope)
+           && vst_source_variance_slope >= 0;
+  }
+};
