 namespace denoise_noise_estimator_detail
 {
 struct observation
@@ -631,6 +658,39 @@ collect_three_scales (int width, int height, GETSUPPORT getsupport,
   result.spacing3 = fit (spacing3, min_support);
   return result;
 }
+
+/* Convert positive linear transmission X to photographic density.  Reject
+   non-positive samples rather than clipping them: clipping would manufacture
+   artificial low-density agreement in the scale diagnostic.  */
+inline bool
+density_transform (luminosity_t x, luminosity_t *out)
+{
+  if (!(x > 0) || !my_isfinite (x))
+    return false;
+  *out = -std::log (x);
+  return my_isfinite (*out);
+}
+
+/* Apply the generalized square-root variance-stabilizing transform for
+   variance A + B*X.  The rationalized form is numerically stable as B tends
+   to zero and differs from the integral of 1/sqrt(A+B*X) only by an additive
+   constant, which is irrelevant to second differences.  */
+inline bool
+variance_stabilizing_transform (luminosity_t x, luminosity_t a,
+                                luminosity_t b, luminosity_t *out)
+{
+  if (!my_isfinite (x) || !(a > 0) || !my_isfinite (a)
+      || !(b >= 0) || !my_isfinite (b))
+    return false;
+  luminosity_t variance = a + b * x;
+  if (!(variance > 0) || !my_isfinite (variance))
+    return false;
+  luminosity_t denom = std::sqrt (variance) + std::sqrt (a);
+  if (!(denom > 0) || !my_isfinite (denom))
+    return false;
+  *out = 2 * x / denom;
+  return my_isfinite (*out);
+}
 } // namespace denoise_noise_estimator_detail
 
