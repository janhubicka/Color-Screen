## -*- sh -*-
## incomplete.test -- Test incomplete command handling

# Common definitions
if test -z "$srcdir"; then
    srcdir=echo "$0" | sed 's,[^/]*$,,'
    test "$srcdir" = "$0" && srcdir=.
    test -z "$srcdir" && srcdir=.
    test "${VERBOSE+set}" != set && VERBOSE=1
fi
echo 1..9
. $srcdir/defs.sh
NAME=dufaycolor_dt_captureone_export

# Verify the physical stitch in the common project coordinate system rather
# than the independently detected screen-grid coordinates.  Depending on
# platform/compiler, equivalent detections currently report raw offsets -27,5
# or -28,5 and correspondingly different "final" values, but both produce the
# same project displacement (right -19,-40).  The exact known-pixel count also
# differs slightly between mesh/no-mesh paths, so keep only a narrow overlap
# range as a quality check.  Explicit numeric conversion also tolerates CRLF
# reports produced by the Windows testsuite.
check_stitch_match ()
{
    awk '
      /Best match on offset/ {
        for (i = 1; i <= NF; i++)
          if ($i == "overlap" && i + 1 <= NF) {
            overlap = $(i + 1) + 0;
            if (overlap >= 58.0 && overlap <= 60.0)
              good_overlap = 1;
          }
      }
      $1 == "right" && NF >= 3 {
        x = $2;
        sub(/,$/, "", x);
        if (x + 0 == -19 && $3 + 0 == -40)
          good_placement = 1;
      }
      END { exit good_overlap && good_placement ? 0 : 1; }
    ' "$1"
}

pexec $RUNCOLORSCREEN stitch --ncols 2 "$srcdir/${NAME}_tile1.jpg" "$srcdir/${NAME}_tile2.jpg"  --out "out-${NAME}.csprj"  --report "out-${NAME}.txt" --no-cpfind  --min-screen-percentage=80 --max-unknown-screen-range=10 || exit 1
check_stitch_match "out-${NAME}.txt" || exit 1
echo 'ok 1 - stitch project construction'
pexec $RUNCOLORSCREEN stitch --ncols 2 "$srcdir/${NAME}_tile1.jpg" "$srcdir/${NAME}_tile2.jpg"  --out "out-${NAME}-nomesh.csprj"  --report "out-${NAME}.txt" --no-cpfind  --no-mesh --min-screen-percentage=80 --max-unknown-screen-range=10 || exit 1
check_stitch_match "out-${NAME}.txt" || exit 1
echo 'ok 2 - stitch project construction no mesh'
PARNAME=out-${NAME}
pexec $RUNCOLORSCREEN autodetect out-${NAME}.csprj ${PARNAME}.par --gamma 2.2  $* || exit 1
echo 'ok 3 - stitch project parameter autodetect'
pexec $RUNCOLORSCREEN autodetect out-${NAME}-nomesh.csprj ${PARNAME}-nomesh.par  --gamma 2.2 $* || exit 1
echo 'ok 4 - stitch project parameter autodetect'
test_all_render_modes out-${NAME}.csprj ${PARNAME}
echo 'ok 5 - stitch project render'
test_all_render_modes out-${NAME}-nomesh.csprj ${PARNAME}
echo 'ok 6 - stitch project render'

# A JSON project written to another directory must still point to the same
# scans. Use files copied into the build directory and *relative* input names
# rather than the source tree's absolute paths used by tests 1-6.
PORTABLE=out-${NAME}-portable
mkdir -p "$PORTABLE" || exit 1
cp "$srcdir/${NAME}_tile1.jpg" "out-${NAME}-tile1.jpg" || exit 1
cp "$srcdir/${NAME}_tile2.jpg" "out-${NAME}-tile2.jpg" || exit 1
pexec $RUNCOLORSCREEN stitch --ncols 2 "out-${NAME}-tile1.jpg" "out-${NAME}-tile2.jpg" --out "$PORTABLE/moved.csprj" --no-cpfind --min-screen-percentage=80 --max-unknown-screen-range=10 || exit 1
echo 'ok 7 - relocated JSON project with relative scan paths'

# Opening it from the parent build directory exercises the project-directory
# base rather than accidentally resolving the tile names against process CWD.
pexec $RUNCOLORSCREEN autodetect "$PORTABLE/moved.csprj" "$PORTABLE/parameters.par" --gamma 2.2 || exit 1
echo 'ok 8 - relocated project opens relative scan paths'

# The CLI --load-project path must also establish the source directory before
# constructing images and allow saving the project again without relinking.
pexec $RUNCOLORSCREEN stitch --load-project "$PORTABLE/moved.csprj" --out "$PORTABLE/reopened.csprj" || exit 1
( cd "$PORTABLE" && $RUNCOLORSCREEN autodetect reopened.csprj from-nested.par --gamma 2.2 ) || exit 1
echo 'ok 9 - CLI load-project and reopen from another working directory'

