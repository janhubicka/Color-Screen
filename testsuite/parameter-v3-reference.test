## -*- sh -*-
## Parameter schema-3 semantic reference mapping (not a product writer).

if test -z "$srcdir"; then
    srcdir=$(echo "$0" | sed 's,[^/]*$,,')
    test -z "$srcdir" && srcdir=.
fi
. "$srcdir/defs.sh"
echo 1..1

program="$top_builddir/src/colorscreen/colorscreen$EXEEXT"
case $(uname -s 2>/dev/null) in
  MINGW*|MSYS*)
    real_program="$top_builddir/src/colorscreen/.libs/colorscreen.exe"
    if test -x "$real_program"; then
        program="$real_program"
        PATH="$top_builddir/src/libcolorscreen/.libs:$PATH"
        export PATH
    fi
    ;;
esac

if python3 -X utf8 "$srcdir/check-parameter-v3-reference.py" \
        "$srcdir/.." "$program"; then
    echo 'ok 1 - schema-3 reference preserves every supported v2 persistent field'
else
    echo 'not ok 1 - schema-3 reference mapping lost data or accepted an invalid edit'
    exit 1
fi
