## -*- sh -*-
## raw-demosaic-cache.test -- Generate a tiny CFA DNG and test retained RAW reprocessing.

set -eu

if test -z "${srcdir:-}"; then
    srcdir=$(dirname "$0")
fi

raw_file=raw-demosaic-cache-fixture.dng
trap 'rm -f "$raw_file"' EXIT HUP INT TERM

# Write a compact, uncompressed TIFF/DNG containing a conventional 2x2 Bayer
# RGGB mosaic. Use only Python's standard library, so this runs on all CI
# targets without adding a DNG generator dependency or a large binary fixture.
python3 - "$raw_file" <<'PY'
import math
import struct
import sys

path = sys.argv[1]
width = 128
height = 128
def ushort(*values):
    return struct.pack("<" + "H" * len(values), *values)
def ulong(*values):
    return struct.pack("<" + "I" * len(values), *values)
def rat(pairs, signed=False):
    code = "ii" if signed else "II"
    return struct.pack("<" + code * len(pairs), *(v for p in pairs for v in p))

# TIFF types: BYTE=1, ASCII=2, SHORT=3, LONG=4, RATIONAL=5, SRATIONAL=10.
tags = [
    (254, 4, ulong(0)),                       # NewSubfileType
    (256, 4, ulong(width)),
    (257, 4, ulong(height)),
    (258, 3, ushort(16)),
    (259, 3, ushort(1)),                      # Uncompressed
    (262, 3, ushort(32803)),                  # CFA photometric
    (271, 2, b"Color-Screen\\x00".replace(b"\\x00", b"\x00")),
    (272, 2, b"Synthetic RGGB\\x00".replace(b"\\x00", b"\x00")),
    (273, 4, ulong(0)),                       # Filled with strip offset
    (274, 3, ushort(1)),
    (277, 3, ushort(1)),
    (278, 4, ulong(height)),
    (279, 4, ulong(width * height * 2)),
    (284, 3, ushort(1)),
    (33421, 3, ushort(2, 2)),                 # CFARepeatPatternDim
    (33422, 1, bytes((0, 1, 1, 2))),         # CFAPattern RGGB
    (339, 3, ushort(1)),
    (50706, 1, bytes((1, 4, 0, 0))),         # DNGVersion
    (50707, 1, bytes((1, 1, 0, 0))),         # DNGBackwardVersion
    (50708, 2, b"Color-Screen RAW cache test\\x00".replace(b"\\x00", b"\x00")),
    (50710, 1, bytes((0, 1, 2))),            # CFAPlaneColor
    (50711, 3, ushort(1)),                   # CFALayout rectangular
    (50713, 3, ushort(1, 1)),                # BlackLevelRepeatDim
    (50714, 4, ulong(0)),                    # BlackLevel
    (50717, 4, ulong(65535)),                # WhiteLevel
    (50718, 5, rat([(1, 1), (1, 1)])),       # DefaultScale
    (50719, 4, ulong(0, 0)),                 # DefaultCropOrigin
    (50720, 4, ulong(width, height)),        # DefaultCropSize
    (50721, 10, rat([(1 if i in (0, 4, 8) else 0, 1)
                       for i in range(9)], signed=True)),  # ColorMatrix1
    (50728, 5, rat([(1, 1)] * 3)),           # AsShotNeutral
    (50778, 3, ushort(21)),                  # CalibrationIlluminant1 = D65
    (50829, 4, ulong(0, 0, height, width)),  # ActiveArea
]
sizes = {1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 10: 8}
tags.sort(key=lambda e: e[0])
ifd_bytes = 2 + len(tags) * 12 + 4
next_offset = 8 + ifd_bytes
payload = bytearray()
records = []
for code, dtype, value in tags:
    if len(value) % sizes[dtype]:
        raise SystemExit("Invalid synthetic TIFF value size")
    count = len(value) // sizes[dtype]
    if len(value) <= 4:
        word = value.ljust(4, b"\x00")
    else:
        if next_offset % 2:
            payload.append(0)
            next_offset += 1
        word = ulong(next_offset)
        payload.extend(value)
        next_offset += len(value)
    records.append((code, dtype, count, word))

if next_offset % 2:
    payload.append(0)
    next_offset += 1
strip_offset = next_offset
records = [(tag, typ, num, ulong(strip_offset) if tag == 273 else word)
           for tag, typ, num, word in records]
raw = bytearray()
for y in range(height):
    for x in range(width):
        signal = 11000 + x * 64 + y * 57 + int(1400 * math.sin(x * .083 + y * .047))
        c = (0, 1, 1, 2)[(y % 2) * 2 + x % 2]
        raw.extend(ushort(max(0, min(65535, signal + (400 if c == 0 else 0)
                                           + (1100 if c == 2 else 0)))))
with open(path, "wb") as f:
    f.write(b"II" + ushort(42) + ulong(8))
    f.write(ushort(len(records)))
    for tag, typ, num, word in records:
        f.write(ushort(tag, typ) + ulong(num) + word)
    f.write(ulong(0))
    f.write(payload)
    f.write(raw)
PY

COLORSCREEN_RAW_CACHE_TEST_FILE="$raw_file" \
    ../src/libcolorscreen/unittests raw_source_variant
