## -*- sh -*-
## parameter-archive-cli.test -- CLI legacy/archive parameter parity

if test -z "$srcdir"; then
    srcdir=echo "$0" | sed 's,[^/]*$,,'
    test "$srcdir" = "$0" && srcdir=.
    test -z "$srcdir" && srcdir=.
    test "${VERBOSE+set}" != set && VERBOSE=1
fi

echo 1..5
. $srcdir/defs.sh

archive=$(python3 -X utf8 - <<'PY'
print("out-parameter-\u017elu\u0165ou\u010dk\u00fd-\u6d4b\u8bd5.cspar")
PY
)
legacy_out=out-parameter-legacy.tif
archive_out=out-parameter-archive.tif
rm -f "$archive" "$legacy_out" "$archive_out"

python3 - "$srcdir/empty.par" "$archive" <<'PY' || exit 1
import json
import sys
import zipfile

source, destination = sys.argv[1:3]
with open(source, "rb") as f:
    payload = f.read()
payload += (
    b"colorscreen_qt_metadata_version: 1\n"
    b"profile_spot: 0.25 0.5\n"
    b"colorscreen_qt_metadata_end\n"
)
manifest = {
    "format": "org.colorscreen.parameters",
    "schema_version": 1,
    "generator": {
        "application": "Color-Screen testsuite",
        "version": "2.0alpha",
    },
    "state": {"legacy_csp": "state/legacy.par"},
    "payloads": [],
}
with zipfile.ZipFile(destination, "w") as z:
    z.writestr(
        "manifest.json",
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        compress_type=zipfile.ZIP_STORED,
    )
    z.writestr(
        "state/legacy.par", payload, compress_type=zipfile.ZIP_DEFLATED
    )
PY

pexec $RUNCOLORSCREEN render --mode original --geometry scan \
  --output-profile=original "$srcdir/checkerboard.tif" "$srcdir/empty.par" \
  "$legacy_out" || exit 1
echo 'ok 1 - legacy parameter render'

pexec $RUNCOLORSCREEN render --mode original --geometry scan \
  --output-profile=original "$srcdir/checkerboard.tif" "$archive" \
  "$archive_out" || exit 1
echo 'ok 2 - archive parameter render'

pexec $RUNCOLORSCREEN lab compare-images "$legacy_out" "$archive_out" || exit 1
echo 'ok 3 - legacy/archive outputs match'

pexec $RUNCOLORSCREEN adjust-par "$archive" || exit 1
python3 - "$archive" <<'PY' || exit 1
import sys
import zipfile

path = sys.argv[1]
if not zipfile.is_zipfile(path):
    raise SystemExit("adjust-par replaced archive with plain text")
with zipfile.ZipFile(path, "r") as z:
    payload = z.read("state/legacy.par")
if b"colorscreen_qt_metadata_version: 1\n" not in payload:
    raise SystemExit("adjust-par dropped Qt metadata version")
if b"profile_spot: 0.25 0.5\n" not in payload:
    raise SystemExit("adjust-par dropped Qt profile spot")
if not payload.endswith(b"colorscreen_qt_metadata_end\n"):
    raise SystemExit("adjust-par truncated Qt metadata")
PY
echo 'ok 4 - adjust-par preserves archive and trailing metadata'

pexec $RUNCOLORSCREEN render --mode original --geometry scan \
  --output-profile=original "$srcdir/checkerboard.tif" "$archive" \
  "$archive_out" || exit 1
echo 'ok 5 - rewritten Unicode archive remains readable'

rm -f "$archive"
