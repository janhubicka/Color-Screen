## -*- sh -*-
## parameter-archive-cli.test -- native JSON and historical .par persistence

if test -z "$srcdir"; then
    srcdir=$(echo "$0" | sed 's,[^/]*$,,')
    test "$srcdir" = "$0" && srcdir=.
    test -z "$srcdir" && srcdir=.
fi
. "$srcdir/defs.sh"
echo 1..15

# Use the real native Windows command line, not libtool's ANSI argv wrapper.
case $(uname -s 2>/dev/null) in
  MINGW*|MSYS*)
    real_colorscreen="$top_builddir/src/colorscreen/.libs/colorscreen.exe"
    if test -x "$real_colorscreen"; then
      PATH="$top_builddir/src/libcolorscreen/.libs:$PATH"
      export PATH
      RUNCOLORSCREEN="$WRAP$real_colorscreen --verbose-tasks"
    fi
    ;;
esac

unicode=$(python3 -X utf8 - <<'PY'
print("out-parameter-žluťoučký-测试.cspar")
PY
)
legacy=out-parameter-legacy-normal.par
legacy_metadata=out-parameter-profile.par
native=out-parameter-native-v3.cspar
legacy_image=out-parameter-legacy.tif
native_image=out-parameter-native.tif
out=out-parameter-output.cspar
unknown=out-parameter-unknown.cspar
rm -f "$legacy" "$legacy_metadata" "$native" "$unicode" "$out" \
      "$unknown" "$legacy_image" "$native_image"

pexec $RUNCOLORSCREEN adjust-par --out "$legacy" "$srcdir/empty.par" || exit 1
pexec $RUNCOLORSCREEN render --mode original --geometry scan \
  --output-profile=original "$srcdir/checkerboard.tif" "$legacy" \
  "$legacy_image" || exit 1
echo 'ok 1 - historical .par reads and renders'

pexec $RUNCOLORSCREEN adjust-par --out "$native" "$legacy" || exit 1
python3 - "$native" <<'PY' || exit 1
import json, pathlib, sys
path=pathlib.Path(sys.argv[1])
doc=json.loads(path.read_text(encoding='utf-8'))
assert doc['format']=='org.colorscreen.parameters' and doc['schema_version']==3
assert 'state' not in doc and 'legacy_csp' not in doc
PY
echo 'ok 2 - .par to native JSON has complete schema identity'

pexec $RUNCOLORSCREEN render --mode original --geometry scan \
  --output-profile=original "$srcdir/checkerboard.tif" "$native" \
  "$native_image" || exit 1
pexec $RUNCOLORSCREEN lab compare-images "$legacy_image" "$native_image" || exit 1
echo 'ok 3 - legacy and JSON render the same pixels'

cp "$native" "$out" || exit 1
pexec $RUNCOLORSCREEN adjust-par "$native" || exit 1
cmp "$native" "$out" || exit 1
echo 'ok 4 - canonical native JSON is stable on ordinary rewriting'

pexec $RUNCOLORSCREEN adjust-par --json-v3 --out "$unicode" "$legacy" || exit 1
cmp "$native" "$unicode" || exit 1
echo 'ok 5 - explicit conversion is canonical with Unicode output names'

# Profile spots are Qt document parameters but also supported by the CLI.
cp "$legacy" "$legacy_metadata" || exit 1
printf 'colorscreen_qt_metadata_version: 1\nprofile_spot: 0.25 0.5\ncolorscreen_qt_metadata_end\n' >> "$legacy_metadata"
pexec $RUNCOLORSCREEN adjust-par --out "$out" "$legacy_metadata" || exit 1
python3 - "$out" <<'PY' || exit 1
import json,pathlib,sys
state=json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
assert state['calibration']['process_color']['spots']==[[0.25,0.5]]
PY
echo 'ok 6 - legacy Qt profile spots convert to native JSON'

pexec $RUNCOLORSCREEN adjust-par --out out-parameter-profile-restored.par "$out" || exit 1
pexec $RUNCOLORSCREEN adjust-par --out out-parameter-profile-restored.cspar out-parameter-profile-restored.par || exit 1
cmp "$out" out-parameter-profile-restored.cspar || exit 1
echo 'ok 7 - Qt profile spots survive JSON to .par to JSON'

if $RUNCOLORSCREEN adjust-par --json-v3 --out out-parameter-invalid-json.par "$native" \
    >out-parameter-format-refusal.log 2>&1; then
  echo 'explicit JSON save accepted .par suffix' >&2
  exit 1
fi
test ! -e out-parameter-invalid-json.par || exit 1
echo 'ok 8 - explicit JSON requests require .cspar extension'

# A historical .par cannot represent selected photographic bounds/final frame.
python3 - "$native" "$out" <<'PY' || exit 1
import json,pathlib,sys
s=json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
s['geometry']['final_frame']['angle_deg']=108.375
s['geometry']['final_frame']['axis_length_ratio']=0.803158
pathlib.Path(sys.argv[2]).write_text(json.dumps(s,ensure_ascii=False)+'\n',encoding='utf-8')
PY
if $RUNCOLORSCREEN adjust-par --out out-parameter-loss.par "$out" \
    >out-parameter-loss.log 2>&1; then
  echo 'native-only geometry was lost in .par export' >&2
  exit 1
fi
test ! -e out-parameter-loss.par || exit 1
grep -q 'final screen angle/ratio' out-parameter-loss.log || exit 1
echo 'ok 9 - incompatible .par export refuses to lose final frame'

# The legacy parser may leave a linefeed after a CRLF terminator.
python3 - <<'PY' || exit 1
from pathlib import Path
Path('out-parameter-crlf.par').write_bytes(b'screen_alignment_version: 1\nscreen_alignment_end\r\n')
Path('out-parameter-vendor.par').write_bytes(b'screen_alignment_version: 1\nscreen_alignment_end\r\nother_vendor_metadata: retained\n')
PY
pexec $RUNCOLORSCREEN adjust-par --out out-parameter-crlf-normal.par out-parameter-crlf.par || exit 1
pexec $RUNCOLORSCREEN adjust-par --out out-parameter-crlf.cspar out-parameter-crlf-normal.par || exit 1
pexec $RUNCOLORSCREEN adjust-par --out out-parameter-crlf-roundtrip.par out-parameter-crlf.cspar || exit 1
cmp out-parameter-crlf-normal.par out-parameter-crlf-roundtrip.par || exit 1
echo 'ok 10 - legacy CRLF normalization is byte-stable through JSON'

pexec $RUNCOLORSCREEN adjust-par --out out-parameter-vendor-keep.par out-parameter-vendor.par || exit 1
grep -q 'other_vendor_metadata: retained' out-parameter-vendor-keep.par || exit 1
echo 'ok 11 - legacy rewriting retains unknown extensions verbatim'

if $RUNCOLORSCREEN adjust-par --out out-parameter-vendor.cspar out-parameter-vendor.par \
    >out-parameter-vendor.log 2>&1; then
  echo 'unknown metadata silently dropped on JSON conversion' >&2
  exit 1
fi
test ! -e out-parameter-vendor.cspar || exit 1
grep -q 'unrecognized trailing metadata' out-parameter-vendor.log || exit 1
echo 'ok 12 - JSON conversion refuses unknown legacy metadata'

# Implicit replacement checks the entire schema, not the leading '{'.
for kind in text empty malformed future incomplete unknown_field bad_type binary; do
  python3 - "$unknown" "$kind" "$native" <<'PY' || exit 1
from pathlib import Path
import json,sys
path=Path(sys.argv[1]);kind=sys.argv[2]
raw={
  'text':b'unknown format\n', 'empty':b'{}', 'malformed':b'{broken',
  'future':b'{"format":"org.colorscreen.parameters","schema_version":999}',
  'incomplete':b'{"format":"org.colorscreen.parameters","schema_version":3}',
  'binary':b'PK\x03\x04unsupported format'
}
if kind in ('unknown_field','bad_type'):
  doc=json.loads(Path(sys.argv[3]).read_text(encoding='utf-8'))
  if kind=='unknown_field':doc['capture']['future_key']=True
  else:doc['capture']['linearization']='invalid'
  raw=json.dumps(doc).encode('utf-8')
else:raw=raw[kind]
path.write_bytes(raw)
PY
  cp "$unknown" "$unknown.before" || exit 1
  if $RUNCOLORSCREEN adjust-par --out "$unknown" "$native" \
      >out-parameter-unknown.log 2>&1; then
    echo "implicit overwrite accepted $kind" >&2; exit 1
  fi
  cmp "$unknown" "$unknown.before" || exit 1
  grep -q 'Refusing to replace unrecognized existing' out-parameter-unknown.log || exit 1
done
echo 'ok 13 - implicit saves preserve malformed, future and unsupported files'

pexec $RUNCOLORSCREEN adjust-par --json-v3 --out "$unknown" "$native" || exit 1
cmp "$unknown" "$native" || exit 1
echo 'ok 14 - explicit JSON conversion may replace an invalid destination'

# A raw ZIP signature must not be silently accepted as a parameter file.
python3 - <<'PY' || exit 1
from pathlib import Path
Path('out-parameter-nonexistent-zip.cspar').write_bytes(b'PK\x03\x04unsupported old parameter archive')
PY
if $RUNCOLORSCREEN adjust-par out-parameter-nonexistent-zip.cspar \
    >out-parameter-nozip.log 2>&1; then
  echo 'unsupported old parameter ZIP unexpectedly loaded' >&2; exit 1
fi
cmp out-parameter-nonexistent-zip.cspar out-parameter-nonexistent-zip.cspar || exit 1
echo 'ok 15 - parameter ZIP archives are not supported'

rm -f "$legacy" "$legacy_metadata" "$native" "$unicode" "$out" \
      "$unknown" "$unknown.before" "$legacy_image" "$native_image" \
      out-parameter-profile-restored.* out-parameter-format-refusal.log \
      out-parameter-loss.log out-parameter-crlf* out-parameter-vendor* \
      out-parameter-unknown.log out-parameter-nozip.log \
      out-parameter-nonexistent-zip.cspar
