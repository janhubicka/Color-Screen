## -*- sh -*-
## incomplete.test -- Test incomplete command handling

# Common definitions
if test -z "$srcdir"; then
    srcdir=echo "$0" | sed 's,[^/]*$,,'
    test "$srcdir" = "$0" && srcdir=.
    test -z "$srcdir" && srcdir=.
    test "${VERBOSE+set}" != set && VERBOSE=1
fi
echo 1..6
. $srcdir/defs.sh
NAME=dufaycolor_nikon_coolsan9000ED_4000DPI_raw
CAPTURE_SHARPEN=out-$NAME-capture-sharpen.par
cat > "$CAPTURE_SHARPEN" <<EOF
screen_alignment_version: 1
sharpen: unsharp-mask
sharpen_radius: 2
sharpen_amount: 3
EOF
trap 'rm -f "$CAPTURE_SHARPEN"' EXIT HUP INT TERM
DETECT_SHARPEN="--par=$CAPTURE_SHARPEN --screen-type=Dufay"
test_autodetect $NAME out-$NAME-mesh-fixed-lens $DETECT_SHARPEN --gamma 1 --mesh --min-screen-percentage=99 --max-unknown-screen-range=2
echo 'ok 1 - autodetect with mesh and fixed lens'
test_autodetect_and_render $NAME out-$NAME-mesh $DETECT_SHARPEN --gamma 1 --mesh --scanner-type=horizontally-moving-lens --min-screen-percentage=99  --max-unknown-screen-range=2
echo 'ok 2 - autodetect and render with mesh and horizontally moving'
test_autodetect $NAME out-$NAME-nomesh-fixed-lens $DETECT_SHARPEN --gamma 1 --no-mesh  --min-screen-percentage=99  --max-unknown-screen-range=2
echo 'ok 3 - autodetect with mesh and fixed lens'
test_autodetect_and_render $NAME out-$NAME-nomesh $DETECT_SHARPEN --gamma 1 --no-mesh --scanner-type=horizontally-moving-lens --min-screen-percentage=99  --max-unknown-screen-range=2
echo 'ok 4 - autodetect and render without mesh and horizontally moving'
test_autodetect $NAME out-$NAME-nomesh-fast $DETECT_SHARPEN --gamma 1 --no-mesh --no-slow-floodfill --fast-floodfill --scanner-type=horizontally-moving-lens  --min-screen-percentage=90  --max-unknown-screen-range=2
echo 'ok 5 - autodetect using fast floodfill only'
test_autodetect $NAME out-$NAME-nomesh-slow $DETECT_SHARPEN --gamma 1 --no-mesh --no-fast-floodfill --slow-floodfill --scanner-type=horizontally-moving-lens --min-screen-percentage=80  --max-unknown-screen-range=2
echo 'ok 6 - autodetect using slow floodfill only'
