+          v[k] = denoise_density_transform (v[k]);
+        return v;
+      },
+      getsupport, entry_to_scr);
+  result.variance_stabilizer_model = result.linear.spacing1;
+  if (result.variance_stabilizer_model.valid_p ())
+    result.variance_stabilized = estimate_screen_rgb_noise_three_scale_model (
+        width, height,
+        [&] (int x, int y)
+        {
+          rgbdata v = getdata (x, y);
+          for (int k = 0; k < 3; k++)
+            v[k] = denoise_variance_stabilizing_transform (
+                v[k], result.variance_stabilizer_model);
+          return v;
+        },
+        getsupport, entry_to_scr);
+  return result;
+}
+
 template <typename ENTRY_TO_SCR>
 inline bool
 denoise_screen_offset_in_square (int_point_t center, int_point_t sample,
