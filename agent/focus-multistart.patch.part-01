 }
 
+/* Return the process-screen carrier frequency in image cycles/pixel.  This is
+   the frequency whose contrast most directly controls additive-screen colour
+   recovery.  */
+static coord_t
+process_screen_frequency (const scr_to_img_parameters &param,
+                          const image_data &img)
+{
+  if (param.type < 0 || param.type >= max_scr_type)
+    return -1;
+  scr_to_img map;
+  if (!map.set_parameters (param, img))
+    return -1;
+  const coord_t pixel_size
+      = map.pixel_size ({ 0, 0, img.width, img.height });
+  const coord_t frequency = scr_names[param.type].frequency * pixel_size;
+  return my_isfinite (frequency) && frequency > 0 ? frequency : -1;
+}
+
+/* Evaluate the fitted scanner/camera transfer at the process-screen carrier.
+   RGB periodic-screen finetuning currently uses the same achromatic 550 nm
+   transfer as CAPTURE_SHARPEN_PARAMETERS, so mirror that convention here.  */
+static coord_t
+process_screen_mtf (const render_parameters &rparam, uint64_t flags,
+                    const finetune_result &fit, coord_t frequency,
+                    const image_data &img)
+{
+  if (!(frequency > 0) || !fit.success)
+    return -1;
+  render_parameters fitted = rparam;
+  if (!freeze_focus_from_fit (&fitted, flags, fit))
+    return -1;
+  mtf_parameters mtf = fitted.sharpen.scanner_mtf;
+  if (!(flags & finetune_bw) && img.has_rgb ())
+    mtf.wavelength = 550;
+  const coord_t value = mtf.system_mtf (frequency);
+  return my_isfinite (value) ? value : -1;
+}
+
+/* Coupled physical sigma/defocus optimization has a flat corner at zero and
+   multiple compensation basins.  Use the cheap one-dimensional fits to enter
+   sensible basins, then release both parameters and keep the best exact joint
+   pixel fit.  The decomposition may remain non-unique; the resulting carrier
+   MTF is reported separately because that is the quantity needed by colour
+   recovery.  */
+static finetune_result
+multistart_joint_focus (const render_parameters &rparam,
+                        const scr_to_img_parameters &param,
+                        const image_data &img,
+                        const std::vector<point_t> &locations,
+                        const std::vector<finetune_result> &starts,
+                        const finetune_parameters &fparams,
+                        progress_info *progress)
+{
+  constexpr uint64_t coupled
+      = finetune_scanner_mtf_sigma | finetune_scanner_mtf_defocus;
+  if ((fparams.flags & coupled) != coupled
+      || !rparam.sharpen.scanner_mtf.simulate_diffraction_p ())
+    return finetune (rparam, param, img, locations, &starts, fparams, progress);
+
+  struct seed_fit
+  {
+    finetune_result fit;
+    uint64_t flag;
+  };
+  std::vector<seed_fit> seeds;
+  seeds.reserve (2);
+  for (uint64_t flag : { (uint64_t)finetune_scanner_mtf_sigma,
+                         (uint64_t)finetune_scanner_mtf_defocus })
+    {
+      finetune_parameters scalar = fparams;
+      scalar.flags &= ~coupled;
+      scalar.flags |= flag;
+      finetune_result fit
+          = finetune (rparam, param, img, locations, &starts, scalar, progress);
+      if (fit.success && my_isfinite (fit.badness))
+        seeds.push_back ({ std::move (fit), flag });
+    }
+
+  if (seeds.empty ())
+    return finetune (rparam, param, img, locations, &starts, fparams, progress);
+  std::sort (seeds.begin (), seeds.end (),
+             [] (const seed_fit &a, const seed_fit &b) {
+               return a.fit.badness < b.fit.badness;
+             });
+
+  finetune_result best;
+  bool have_best = false;
+  /* Usually the best scalar basin is enough.  Also try the second basin when
+     it is competitive; this catches captures where sigma and defocus trade
+     roles without multiplying the expensive coupled work unnecessarily.  */
+  const coord_t second_seed_ratio = (coord_t)1.03;
+  const size_t attempts
+      = seeds.size () > 1
+                && seeds[1].fit.badness
+                       <= seeds[0].fit.badness * second_seed_ratio
+            ? 2
+            : 1;
+  for (size_t i = 0; i < attempts; i++)
+    {
+      render_parameters seeded = rparam;
+      if (!freeze_focus_from_fit (&seeded, seeds[i].flag, seeds[i].fit))
+        continue;
+      finetune_result fit
+          = finetune (seeded, param, img, locations, &starts, fparams, progress);
+      if (fit.success && my_isfinite (fit.badness)
+          && (!have_best || fit.badness < best.badness))
+        {
+          best = std::move (fit);
+          have_best = true;
+        }
+    }
+  return have_best ? best : seeds.front ().fit;
+}
+
