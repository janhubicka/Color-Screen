1;
+}
+
+/* Evaluate the scanner/system MTF represented by RPARAM at the process-screen
+   carrier.  RGB finetuning uses one achromatic periodic-screen transfer at
+   550 nm, matching FINETUNE's capture_sharpen_parameters path.  */
+static coord_t
+screen_frequency_mtf (const render_parameters &rparam, uint64_t flags,
+                      const image_data &img, coord_t frequency)
+{
+  if (!(my_isfinite (frequency) && frequency > 0))
+    return -1;
+  mtf_parameters mtf = rparam.sharpen.scanner_mtf;
+  if (!(flags & finetune_bw) && img.has_rgb ())
+    mtf.wavelength = 550;
+  const coord_t value = mtf.system_mtf (frequency);
+  return my_isfinite (value) && value >= 0 ? value : -1;
+}
+
+static bool
+better_focus_fit (const finetune_result &candidate,
+                  const finetune_result &best)
+{
+  if (!candidate.success || !my_isfinite (candidate.badness))
+    return false;
+  return !best.success || !my_isfinite (best.badness)
+         || candidate.badness < best.badness;
+}
+
+/* Run the coupled physical sigma+defocus fit from a stable scalar basin.
+
+   At a cold physical start both coordinates are flat near zero and a direct
+   high-dimensional simplex can settle on an arbitrary compensation basin.
+   First solve the same all-area pixel objective in the sigma-only and
+   defocus-only subspaces, keep the better scalar solution, then release both
+   coordinates from that point.  The scalar solution itself remains a valid
+   candidate: if releasing the second coordinate does not improve the actual
+   pixel objective, keep the simpler transfer.  Existing nonzero calibration
+   is naturally retained as the start of both scalar solves; no one-sided
+   constraint is imposed, so a historical screen may fit slightly sharper or
+   blurrier than a separate focus target.  */
+static finetune_result
+fit_coupled_physical_focus (
+    const render_parameters &rparam, const scr_to_img_parameters &param,
+    const image_data &img, const std::vector<point_t> &locations,
+    const std::vector<finetune_result> &starts,
+    const finetune_parameters &fparams, progress_info *progress)
+{
+  finetune_result best;
+  render_parameters best_rparam = rparam;
+  bool have_scalar_seed = false;
+
+  for (uint64_t active : { (uint64_t)finetune_scanner_mtf_sigma,
+                           (uint64_t)finetune_scanner_mtf_defocus })
+    {
+      finetune_parameters scalar = fparams;
+      scalar.interpolate_scanner_mtf_defocus = false;
+      scalar.flags &= ~(finetune_scanner_mtf_sigma
+                        | finetune_scanner_mtf_defocus);
+      scalar.flags |= active;
+      finetune_result fit
+          = finetune (rparam, param, img, locations, &starts, scalar, progress);
+      if (!better_focus_fit (fit, best))
+        continue;
+      render_parameters seeded = rparam;
+      if (!freeze_focus_from_fit (&seeded, scalar.flags, fit))
+        continue;
+      best = std::move (fit);
+      best_rparam = seeded;
+      have_scalar_seed = true;
+    }
+
+  /* If both scalar searches failed, retain the historical direct behavior as
+     a last-resort diagnostic rather than converting a recoverable fit into an
+     analysis failure.  */
+  if (!have_scalar_seed)
+    return finetune (rparam, param, img, locations, &starts, fparams, progress);
+
+  finetune_parameters coupled = fparams;
+  coupled.interpolate_scanner_mtf_defocus = false;
+  finetune_result released
+      = finetune (best_rparam, param, img, locations, &starts, coupled,
+                  progress);
+  if (better_focus_fit (released, best))
+    best = std::move (released);
+  return best;
+}
+
 } // namespace
 
