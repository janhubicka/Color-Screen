diff --git a/src/libcolorscreen/focus-analysis.C b/src/libcolorscreen/focus-analysis.C
--- a/src/libcolorscreen/focus-analysis.C
+++ b/src/libcolorscreen/focus-analysis.C
@@ -196,11 +196,54 @@ multistart_joint_focus_fit (
   if (scalar[first].success)
     consider_joint_fit (scalar[first].rparam, param, img, locations, starts,
                         fparams, progress, &best, best_seed_kind,
                         scalar[first].kind);
-  if (scalar[second].success
-      && (!best.success || scalar[second].badness < best.badness))
+  if (scalar[second].success)
     consider_joint_fit (scalar[second].rparam, param, img, locations, starts,
                         fparams, progress, &best, best_seed_kind,
                         scalar[second].kind);
+  if (scalar[1].success
+      && my_isfinite (rparam.sharpen.scanner_mtf.defocus)
+      && rparam.sharpen.scanner_mtf.defocus >= 0
+      && rparam.sharpen.scanner_mtf.defocus <= cold_epsilon)
+    {
+      fprintf (stderr,
+               "focus stage input defocus %.9g scalar-badness %.9g best %.9g\n",
+               (double)scalar[1].rparam.sharpen.scanner_mtf.defocus,
+               (double)scalar[1].badness,
+               best.success ? (double)best.badness : -1.0);
+      finetune_parameters sigma_stage = fparams;
+      sigma_stage.flags &= ~coupled;
+      sigma_stage.flags |= finetune_scanner_mtf_sigma;
+      sigma_stage.interpolate_scanner_mtf_defocus = false;
+      finetune_result fit
+          = finetune (scalar[1].rparam, param, img, locations, &starts,
+                      sigma_stage, progress);
+      fprintf (stderr,
+               "focus stage sigma success %d badness %.9g sigma %.9g result-defocus %.9g\n",
+               fit.success ? 1 : 0, (double)fit.badness,
+               (double)fit.scanner_mtf_sigma,
+               (double)fit.scanner_mtf_defocus);
+      if (fit.success && my_isfinite (fit.badness))
+        {
+          render_parameters staged = scalar[1].rparam;
+          if (freeze_focus_from_fit (&staged, sigma_stage.flags, fit))
+            {
+              fprintf (stderr,
+                       "focus stage frozen sigma %.9g defocus %.9g\n",
+                       (double)staged.sharpen.scanner_mtf.sigma,
+                       (double)staged.sharpen.scanner_mtf.defocus);
+              fit.scanner_mtf_defocus = staged.sharpen.scanner_mtf.defocus;
+              if (!best.success || fit.badness < best.badness)
+                {
+                  best = fit;
+                  if (best_seed_kind)
+                    *best_seed_kind = scalar[1].kind;
+                }
+              consider_joint_fit (staged, param, img, locations, starts,
+                                  fparams, progress, &best, best_seed_kind,
+                                  scalar[1].kind);
+            }
+        }
+    }
   return best;
 }
