+/* Return the magnitude of one periodic-screen Fourier coefficient.  This
+   remains inside the unit-test executable so the regression does not depend
+   on exporting the internal MTF evaluator from libcolorscreen.  */
+static double
+screen_harmonic_magnitude (const screen &scr, int channel, int kx, int ky)
+{
+  std::complex<double> sum (0, 0);
+  for (int y = 0; y < screen::size; y++)
+    for (int x = 0; x < screen::size; x++)
+      {
+        const double angle
+            = -2.0 * M_PI * (kx * x + ky * y) / screen::size;
+        sum += (double)scr.mult[y][x][channel]
+               * std::complex<double> (std::cos (angle), std::sin (angle));
+      }
+  return std::abs (sum) / (screen::size * screen::size);
+}
