+/* Return the process-screen carrier in image cycles/pixel.  The screen table
+   stores the carrier in screen-coordinate units; SCR_TO_IMG::PIXEL_SIZE maps
+   one image pixel back into those units.  */
+static coord_t
+process_screen_frequency (const scr_to_img_parameters &param,
+                          const image_data &img)
+{
+  if (param.type < 0 || param.type >= max_scr_type)
+    return -1;
+  scr_to_img map;
+  if (!map.set_parameters (param, img))
+    return -1;
+  const coord_t pixel_size
+      = map.pixel_size ({ 0, 0, img.width, img.height });
+  const coord_t frequency = scr_names[param.type].frequency * pixel_size;
+  return my_isfinite (frequency) && frequency > 0 ? frequency : -1;
+}
+
+/* Evaluate the scanner/camera transfer represented by FIT at FREQUENCY.
+   Monochrome/BW uses exactly the image-layer-specialized transfer used by
+   FINETUNE, including its capture-channel wavelength.  RGB forward fitting
+   has channel-dependent transfers; its scalar diagnostic uses the configured
+   representative analytical transfer at 550 nm.  */
+static coord_t
+process_screen_mtf (const render_parameters &rparam, const image_data &img,
+                    uint64_t flags, coord_t frequency,
+                    const finetune_result *fit = nullptr)
+{
+  if (!(frequency > 0) || !my_isfinite (frequency))
+    return -1;
+  mtf_parameters mtf
+      = (flags & finetune_bw)
+            ? rparam.get_image_layer_sharpen_parameters (&img).scanner_mtf
+            : rparam.sharpen.scanner_mtf;
+  if (fit && fit->success)
+    {
+      if ((flags & finetune_scanner_mtf_sigma)
+          && my_isfinite (fit->scanner_mtf_sigma)
+          && fit->scanner_mtf_sigma >= 0)
+        mtf.sigma = fit->scanner_mtf_sigma;
+      if (flags & finetune_scanner_mtf_defocus)
+        {
+          if (mtf.simulate_diffraction_p ())
+            {
+              if (my_isfinite (fit->scanner_mtf_defocus)
+                  && fit->scanner_mtf_defocus >= 0)
+                mtf.defocus = fit->scanner_mtf_defocus;
+            }
+          else if (my_isfinite (fit->scanner_mtf_blur_diameter)
+                   && fit->scanner_mtf_blur_diameter >= 0)
+            mtf.blur_diameter = fit->scanner_mtf_blur_diameter;
+        }
+    }
+  if (!(flags & finetune_bw) && img.has_rgb ())
+    mtf.wavelength = 550;
+  const coord_t value = mtf.system_mtf (frequency);
+  return my_isfinite (value) ? value : -1;
+}
+
+/* Copy the scalar scanner-MTF coordinates represented by FIT into a starting
+   render state.  */
+static render_parameters
+seed_focus_from_fit (const render_parameters &base, uint64_t flags,
+                     const finetune_result &fit)
+{
+  render_parameters seeded = base;
+  freeze_focus_from_fit (&seeded, flags, fit);
+  return seeded;
+}
+
 } // namespace
 
