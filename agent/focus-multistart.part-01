+
+/* Return the process-screen carrier frequency in image pixels.  This is the
+   same quantity used by adaptive focus interpolation: SCR_NAMES describes the
+   strongest useful screen harmonic in screen coordinates and PIXEL_SIZE maps
+   it into cycles per scan pixel.  */
+static coord_t
+focus_screen_frequency (const scr_to_img_parameters &param,
+                        const image_data &img)
+{
+  if (param.type < 0 || param.type >= max_scr_type)
+    return -1;
+  scr_to_img map;
+  if (!map.set_parameters (param, img))
+    return -1;
+  const coord_t pixel_size
+      = map.pixel_size ({ 0, 0, img.width, img.height });
+  const coord_t frequency = scr_names[param.type].frequency * pixel_size;
+  return my_isfinite (frequency) && frequency > 0 ? frequency : -