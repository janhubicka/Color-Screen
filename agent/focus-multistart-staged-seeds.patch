+/* At the exact physical (sigma,defocus) origin both transfer coordinates have
+   weak first-order simplex information.  The one-dimensional fits are useful
+   not only as direct joint seeds but also as coordinate-continuation anchors:
+   fit one axis, hold it fixed while fitting the other, then release both.  */
+static bool
+cold_physical_focus_start_p (const render_parameters &rparam)
+{
+  const coord_t sigma = rparam.sharpen.scanner_mtf.sigma;
+  const coord_t defocus = rparam.sharpen.scanner_mtf.defocus;
+  constexpr coord_t epsilon = (coord_t)1e-8;
+  return my_isfinite (sigma) && my_isfinite (defocus) && sigma >= 0
+         && defocus >= 0 && sigma <= epsilon && defocus <= epsilon;
+}
+
