+            cross.interpolate_scanner_mtf_defocus = false;
+          finetune_result fit = finetune (staged, param, img, locations,
+                                         &starts, cross, progress);
+          if (!fit.success || !my_isfinite (fit.badness)
+              || !freeze_focus_from_fit (&staged, cross.flags, fit))
+            continue;
+          consider_joint_fit (staged, param, img, locations, starts, fparams,
+                              progress, &best, best_seed_kind,
+                              scalar[which].kind);
+        }
