+  auto appearance_distance2 = [] (rgbdata a, rgbdata b) {
+    auto feature = [] (rgbdata c) {
+      const double r = std::max ((double)c.red, 0.0);
+      const double g = std::max ((double)c.green, 0.0);
+      const double bl = std::max ((double)c.blue, 0.0);
