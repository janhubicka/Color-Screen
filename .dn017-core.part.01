+   -log(X) and therefore only accepts strictly positive collected samples.
+   VARIANCE_STABILIZED uses the LINEAR spacing-1 floor+slope model to apply
+   the generalized square-root transform whose local derivative is
+   1/sqrt(floor+slope*X).  The transform choice is diagnostic only and does
+   not alter denoising or rendering parameters.  */
+struct denoise_noise_domain_comparison
+{
+  denoise_noise_three_scale_estimate linear;
+  denoise_noise_three_scale_estimate density;
+  denoise_noise_three_scale_estimate variance_stabilized;
+  denoise_noise_estimate variance_stabilizer_model;
+
+  bool valid_p () const
+  {
+    return linear.valid_p () || density.valid_p ()
+           || variance_stabilized.valid_p ();
+  }
+};
+
